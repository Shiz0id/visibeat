# The working tree is Windows and the sources are CRLF; normalise to LF in the
# repository so line endings do not become a diff on every checkout elsewhere.
* text=auto

# Always LF: these are executed by a shell, and CRLF breaks the shebang.
gradlew text eol=lf

# Always CRLF: run by cmd.exe.
gradlew.bat text eol=crlf

# Binary — never normalised, never diffed as text.
*.onnx binary
*.onnx.data binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.jar binary
